# Copy to .env and fill in. .env is ignored by git, so passwords stay on this machine.

# ---- Website (read at build time) ----
# Where the "Request a proposal" form posts. Keep /api/enquiry when the site and server share a domain.
# Leave empty to fall back to opening the visitor's email app.
VITE_ENQUIRY_URL=/api/enquiry
# Where the "Help me choose" guide asks for AI recommendations. Leave empty to keep the
# built-in keyword matching (the guide also falls back to it whenever the server is unavailable).
VITE_ASSISTANT_URL=/api/assistant

# ---- Enquiry server (npm run server) ----
PORT=8787

# SMTP account the emails are sent from. Leave SMTP_HOST empty for PREVIEW mode:
# nothing is sent and each email is saved to server/outbox/*.eml instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Microsoft 365 OAuth2 (app-only sign-in). When all three are filled in, they are used instead
# of SMTP_PASS. Values come from the Entra app registration "MindSuite website mail".
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=

# Sender shown on emails (must be allowed by your SMTP account), and the team inbox.
MAIL_FROM="MindSuite <no-reply@mindsuite.in>"
MAIL_TO=no-reply@mindsuite.in
# Where the visitor's replies to their acknowledgement go
MAIL_REPLY_TO=info@mindsuite.in
# Optional extra recipients, comma-separated
MAIL_CC=
# Send the visitor an acknowledgement email (true/false)
SEND_ACK=true

# Other websites allowed to post to this endpoint (comma-separated), e.g. https://www.mindsuite.in
ALLOWED_ORIGINS=
# At most RATE_LIMIT_MAX requests per visitor in RATE_LIMIT_MINUTES
RATE_LIMIT_MAX=5
RATE_LIMIT_MINUTES=15

# ---- "Help me choose" guide (Claude) ----
# Claude API key from https://console.anthropic.com. Without it the guide uses keyword matching.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
ASSISTANT_MODEL=
# At most ASSISTANT_RATE_LIMIT_MAX guide messages per visitor in ASSISTANT_RATE_LIMIT_MINUTES
ASSISTANT_RATE_LIMIT_MAX=30
ASSISTANT_RATE_LIMIT_MINUTES=15
# Monthly AI budget in US dollars, estimated from token use (default 20; 0 turns alerts off).
# At 90% and again at 100% an email goes to BUDGET_ALERT_TO (comma-separated).
ASSISTANT_MONTHLY_BUDGET_USD=20
BUDGET_ALERT_TO=info@mindsuite.in, privacy@mindsuite.in
# Optional: prices in US dollars per million tokens, if you change ASSISTANT_MODEL
# (defaults are Claude Opus 5.5: input 4, output 20, cached read 0.20, cache write 5).
ASSISTANT_PRICE_INPUT=
ASSISTANT_PRICE_OUTPUT=
ASSISTANT_PRICE_CACHE_READ=
ASSISTANT_PRICE_CACHE_WRITE=
# Where the monthly AI usage total is kept (default server/usage.json)
USAGE_FILE=
