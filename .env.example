# Copy to .env and fill in. .env is ignored by git, so passwords stay on this machine.

# ---- Website (read at build time) ----
# Where the "Request a proposal" form posts. Keep /api/enquiry when the site and server share a domain.
# Leave empty to fall back to opening the visitor's email app.
VITE_ENQUIRY_URL=/api/enquiry

# ---- Enquiry server (npm run server) ----
PORT=8787

# SMTP account the emails are sent from. Leave SMTP_HOST empty for PREVIEW mode:
# nothing is sent and each email is saved to server/outbox/*.eml instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown on emails (must be allowed by your SMTP account), and the team inbox.
MAIL_FROM="MindSuite <no-reply@mindsuite.in>"
MAIL_TO=info@mindsuite.in
# Optional extra recipients, comma-separated
MAIL_CC=
# Send the visitor an acknowledgement email (true/false)
SEND_ACK=true

# Other websites allowed to post to this endpoint (comma-separated), e.g. https://www.mindsuite.in
ALLOWED_ORIGINS=
# At most RATE_LIMIT_MAX requests per visitor in RATE_LIMIT_MINUTES
RATE_LIMIT_MAX=5
RATE_LIMIT_MINUTES=15
